# Required: Deepgram project API key for server-side Voice Agent WebSocket auth.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Override the agent endpoint, e.g. EU regional endpoint.
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# Optional: OpenAI key is only needed when your Deepgram agent settings use the open_ai think provider.
OPENAI_API_KEY=your_openai_api_key_here

PORT=3000

# Optional: Set to 1 to enable aggregate proxy audio/event logging.
DEBUG_AUDIO=0

# Optional: Local RVC service endpoint. Set empty to disable conversion.
RVC_SERVICE_URL=http://127.0.0.1:5055

# Optional: RVC conversion timeout in milliseconds.
RVC_TIMEOUT_MS=120000

# Optional: Local RVC service bind address and port.
RVC_HOST=127.0.0.1
RVC_PORT=5055

# RVC service device for this CPU-only deployment host.
RVC_DEVICE=cpu

# Optional: RVC conversion parameters forwarded to the local service.
RVC_PITCH=0
RVC_INDEX_RATE=0.5
RVC_F0_METHOD=rmvpe

# Optional: Maximum bytes accepted by the RVC service upload endpoint.
RVC_MAX_CONVERT_UPLOAD_BYTES=26214400

# Streaming mode: convert/play assistant audio in silence-delimited segments for faster response.
RVC_STREAMING=1
RVC_SEGMENT_SILENCE_MS=250
RVC_SEGMENT_SILENCE_RMS=0.01
RVC_SEGMENT_MIN_MS=400
RVC_SEGMENT_MAX_MS=4000

# Optional: RVC model discovery overrides. Leave unset to auto-discover nearby .pth/.index files.
# RVC_PROJECT_ROOT=/absolute/path/to/project
# RVC_MODEL_PATH=/absolute/path/to/model.pth
# RVC_INDEX_PATH=/absolute/path/to/model.index
# RVC_MODELS_DIR=/absolute/path/to/models
