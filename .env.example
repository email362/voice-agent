# ElevenLabs Agents Platform
# Create an agent in the ElevenLabs dashboard, then paste the agent id here.
# This POC uses the public agent-id path for browser-only local testing.
# For production or agents that require auth, fetch a signed URL server-side with ELEVENLABS_API_KEY.
VITE_ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Server-side only; do not expose this as VITE_*. Included as a template for adding a signed URL endpoint later.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
